---
import '../styles/global.css';
import '../styles/intelligence-map.css';
import FeedbackCenter from '../components/FeedbackCenter';
import SmartServices from '../components/SmartServices';
import OperationsDemo from '../components/OperationsDemo';
import { products, industries } from '../data/products';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="四川川江科技研究院｜人工智能技术研发与服务，连接产品、行业与创新成果。" />
    <title>四川川江科技研究院 · 川江奔涌，向新而行</title>
    <link rel="icon" href={asset("/brand/logo.png")} type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#mainContent">跳到主要内容</a>
    <header class="site-header">
      <a class="brand" href="#/home" aria-label="四川川江科技研究院首页">
        <img class="brand-logo" src={asset("/brand/logo.png")} alt="川江科技研究院标志" width="48" height="54" />
        <span class="brand-name">四川川江科技研究院<small>CHUANJIANG · RESEARCH &amp; INNOVATION</small></span>
      </a>
      <nav class="main-nav" id="mainNav" aria-label="主导航">
        <a href="#/home" data-route="home" class="active">首页</a>
        <a href="#/products" data-route="products">产品与平台</a>
        <a href="#/solutions" data-route="solutions">行业解决方案</a>
        <a href="#/resources" data-route="resources">服务与资料</a>
        <a href="#/assist?view=ai" data-route="assist">智能服务</a>
        <a href="#/about" data-route="about">关于川江</a>
        <a href="#/support" data-route="support">服务与支持</a>
      </nav>
      <div class="header-actions"><a class="header-search" href="#/assist?view=search" aria-label="站内智能搜索">⌕</a><a class="header-download" href="#/downloads">下载试用 <span>↓</span></a><button id="menuToggle" class="menu-toggle" aria-expanded="false" aria-controls="mainNav" type="button">菜单 +</button></div>
    </header>

    <main id="mainContent">
      <div data-page="home" class="page-view">
        <section class="hero">
          <canvas id="mountainCanvas" aria-hidden="true"></canvas>
          <div class="hero-grain" aria-hidden="true"></div>
          <div class="hero-content container">
            <div class="hero-copy">
              <p class="eyebrow light"><span></span>川江奔涌 · 向新而行</p>
              <h1>懂场景，<br />更懂<span>下一步。</span></h1>
              <p class="hero-lead">让人工智能走进真实业务。<br />从技术研发到成果落地，连接每一种向新的可能。</p>
              <div class="hero-actions"><a class="button button-red" href="#/assist?view=ai">让我们懂你的需求 <span>↗</span></a><a class="button button-outline" href="#/products">探索川江产品 <span>→</span></a></div>
              <div class="hero-proof"><span>人工智能研发</span><i></i><span>行业应用创新</span><i></i><span>科技成果转化</span></div>
            </div>
            <div class="intelligence-map" aria-label="连接场景、人工智能平台与产品的示意图">
              <div class="map-ambient" aria-hidden="true"></div>
              <div class="map-meta"><span><b></b>SCENE TO INTELLIGENCE</span><span>CHUANJIANG / 01</span></div>
              <svg class="map-flow" viewBox="0 0 600 490" aria-hidden="true">
                <defs>
                  <linearGradient id="flowGradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#77b8ab" stop-opacity=".24"/><stop offset=".48" stop-color="#a1ddd0" stop-opacity=".72"/><stop offset="1" stop-color="#d8b777" stop-opacity=".48"/></linearGradient>
                  <linearGradient id="orbitGradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#c8ece0" stop-opacity=".6"/><stop offset=".35" stop-color="#76b4a6" stop-opacity=".08"/><stop offset=".7" stop-color="#76b4a6" stop-opacity=".1"/><stop offset="1" stop-color="#d8b777" stop-opacity=".48"/></linearGradient>
                </defs>
                {['gongge', 'kang', 'zhi', 'lu'].map((id, i) => <g class="map-connection" data-connection={id} style={`--link-delay:${i * -1.8}s`}>
                  <path class="connection-halo" data-link-path={id} fill="none" />
                  <path class="connection-line" data-link-path={id} fill="none" />
                  <path class="connection-light" data-link-path={id} pathLength="1000" fill="none" />
                  <g class="connection-port" data-link-port={id}><circle r="4"/><circle r="1.3"/></g>
                </g>)}
                <g class="map-orbits" transform="translate(300 242)">
                  <circle class="orbit-hairline" r="98" />
                  <circle class="orbit-calibration" r="108" />
                  <g class="orbit-rotation"><circle class="orbit-arc" r="98"/><circle class="orbit-satellite" cx="98" cy="0" r="2.2"/></g>
                  <ellipse class="orbit-equator" cx="0" cy="21" rx="119" ry="28" transform="rotate(-18)"/>
                  <ellipse class="orbit-equator orbit-equator-back" cx="0" cy="27" rx="119" ry="28" transform="rotate(-18)"/>
                  <path class="orbit-guides" d="M0-119v5M0 114v5M-119 0h5M114 0h5" />
                </g>
              </svg>
              <div class="map-center">
                <span class="core-label">CHUANJIANG AI</span>
                <svg class="core-symbol" viewBox="0 0 56 48" aria-hidden="true"><defs><linearGradient id="coreJade" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f3efdc"/><stop offset=".55" stop-color="#b7e5d5"/><stop offset="1" stop-color="#61aaa0"/></linearGradient></defs><path d="M12 5v17c0 9-2 16-6 21M28 5v37M44 5v38" fill="none" stroke="url(#coreJade)" stroke-width="3" stroke-linecap="round"/></svg>
                <strong>AI 要素平台</strong><small>连接 · 理解 · 协同</small>
              </div>
              <a class="map-node node-office" data-map-product="gongge" href="#/products?product=gongge"><span class="node-icon"><img src={asset("/media/product-logos/gongge.png")} alt="" /></span><div><span class="node-index">01 / OFFICE</span><strong>工格办公</strong><small>政企协作</small></div><b aria-hidden="true">↗</b></a>
              <a class="map-node node-care" data-map-product="kang" href="#/products?product=kang"><span class="node-icon"><img src={asset("/media/product-logos/kang.png")} alt="" /></span><div><span class="node-index">02 / CARE</span><strong>康小和</strong><small>智慧医养</small></div><b aria-hidden="true">↗</b></a>
              <a class="map-node node-edu" data-map-product="zhi" href="#/products?product=zhi"><span class="node-icon"><img src={asset("/media/product-logos/zhi.png")} alt="" /></span><div><span class="node-index">03 / EDUCATION</span><strong>智小达</strong><small>智慧教育</small></div><b aria-hidden="true">↗</b></a>
              <a class="map-node node-city" data-map-product="lu" href="#/products?product=lu"><span class="node-icon"><img src={asset("/media/product-logos/lu.png")} alt="" /></span><div><span class="node-index">04 / CITY</span><strong>泸小智</strong><small>酒城智枢</small></div><b aria-hidden="true">↗</b></a>
              <div class="map-note"><span class="map-context">场景理解，是智能的起点。</span><i></i><small>理解 → 连接 → 行动</small></div>
            </div>
          </div>
          <div class="hero-bottom container"><span class="hero-concept">以山的深度，汇水的流动。<small>知音，在于懂你。</small></span><div class="motion-controls"><span class="live-dot"></span><span id="motionState">自驱流动</span><button type="button" id="micToggle" aria-pressed="false">声音增强 +</button><p id="micStatus" role="status" class="sr-only">无需声音，流线也会持续流动。</p></div><a href="#homeProducts" class="scroll-cue">向下探索 <span>↓</span></a></div>
        </section>

        <section class="brand-strip container" aria-label="研究院关键数据">
          <p>扎根真实场景<br /><strong>让创新有迹可循</strong></p><div><strong>40<span>余项</span></strong><small>软件著作权及专利</small></div><div><strong>30<span>余名</span></strong><small>汇聚博士专家</small></div><div><strong>3<span>家</span></strong><small>孵化落地业务公司</small></div><div class="strip-label">国家高新技术企业<br /><span>四川省“专精特新”中小企业</span></div>
        </section>

        <section class="section container" id="homeProducts">
          <div class="section-head"><div><p class="eyebrow">01 / PRODUCTS &amp; PLATFORM</p><h2>把智能，带到<span>你的场景里。</span></h2><p class="section-lead">以 AI 要素先进平台为核心，连接专业智能体与行业应用。</p></div><a class="text-link" href="#/products">查看全部产品 <span>↗</span></a></div>
          <div class="product-grid">{products.map(product => <article class={`product-card accent-${product.color}`}><div class="product-card-top"><span class="product-icon"><img src={asset(`/media/product-logos/${product.id}.png`)} alt="" /></span><small>{product.tag} / AI AGENT</small><span class="card-arrow">↗</span></div><h3>{product.name}</h3><p class="product-type">{product.type}</p><p class="product-line">{product.line}</p><div class="product-mini-art" aria-hidden="true"><div class="mini-orbit"></div><i></i><i></i><i></i><img src={asset(`/media/product-logos/${product.id}.png`)} alt="" /><span>{product.tag}</span></div><a href={`#/products?product=${product.id}`} class="card-link">了解产品 <span>→</span></a></article>)}</div>
        </section>

        <section class="industry-section section">
          <div class="container"><div class="section-head"><div><p class="eyebrow">02 / INDUSTRY SOLUTIONS</p><h2>先懂行业，<span>再谈智能。</span></h2><p class="section-lead">让技术顺着业务生长，让每一步都更靠近实际需要。</p></div><a class="text-link" href="#/solutions">探索解决方案 <span>↗</span></a></div>
          <div class="industry-tabs" role="tablist" aria-label="选择行业场景">{industries.map((industry, i) => <button type="button" role="tab" aria-selected={i === 0} aria-controls="industryPanel" class={i === 0 ? 'active' : ''} data-industry={i}>{industry.label}<span>0{i + 1}</span></button>)}</div>
          <div class="industry-panel" id="industryPanel" role="tabpanel"><div class="industry-copy"><p id="industryEnglish" class="eyebrow">{industries[0].english}</p><h3 id="industryTitle">{industries[0].title}</h3><p id="industryDescription">{industries[0].description}</p><ul id="industryList">{industries[0].list.map(item => <li>{item}</li>)}</ul><a id="industryLink" class="text-link" href="#/solutions?industry=office">了解这个场景 <span>↗</span></a></div><div class="scene-preview"><div class="scene-top"><span id="sceneProduct">工格办公</span><small>AI + SCENARIO</small><i></i><i></i><i></i></div><div class="scene-body"><aside><b>川</b><span>场景</span><span>资料</span><span>协同</span></aside><div class="scene-main"><p class="scene-greeting" id="sceneGreeting">从一件具体的工作开始。</p><div class="scene-search"><span>告诉我，你正在思考什么？</span><b>↑</b></div><div class="scene-tasks"><div><small>UNDERSTAND</small><strong>理解场景</strong><i></i><i></i></div><div><small>CONNECT</small><strong>连接信息</strong><i></i><i></i></div><div><small>ACT</small><strong>协同行动</strong><i></i><i></i></div></div><p class="scene-note">产品界面概念示意</p></div></div></div></div>
          </div>
        </section>

        <section class="understanding-section section container"><div class="understanding-art" aria-hidden="true"><svg viewBox="0 0 480 360"><defs><linearGradient id="uFlow"><stop stop-color="#c5d9c7"/><stop offset="1" stop-color="#67afa0"/></linearGradient></defs>{Array.from({length:12}, (_, i) => <path d={`M-20 ${235+i*7} C100 ${260-i*11}, 190 ${150+i*12}, 280 ${205+i*5} S410 ${130+i*9}, 500 ${200+i*6}`} stroke="url(#uFlow)" fill="none" stroke-width={i % 4 === 0 ? 1.5 : .6}/>)}</svg><div class="understanding-core">懂</div><span>CONTEXT → INTELLIGENCE → VALUE</span></div><div class="understanding-copy"><p class="eyebrow">03 / UNDERSTANDING YOU</p><h2>知音，不止于声音。<br /><span>更在于理解。</span></h2><p>从一份资料、一个业务问题，到一段服务流程。川江以人工智能研发与行业实践，让技术理解真实语境，让成果落到具体场景。</p><div class="intent-buttons" role="group" aria-label="选择你关心的方向"><button type="button" class="active" aria-pressed="true" data-intent="0">提升组织协作</button><button type="button" aria-pressed="false" data-intent="1">连接医养服务</button><button type="button" aria-pressed="false" data-intent="2">探索教育创新</button></div><div class="intent-answer"><span>↗</span><p id="intentResponse" role="status" aria-live="polite">从工格办公出发，探索 AI 与组织协作的融合。</p><a id="intentLink" href="#/products?product=gongge">了解方向 →</a></div></div></section>

        <section class="about-preview section"><div class="container about-preview-grid"><div><p class="eyebrow light">04 / RESEARCH TO REALITY</p><h2>让创新成果，<br /><span>奔涌向前。</span></h2><p>以人工智能技术研发和服务为核心，推动科技创新、成果转化、资本赋能与产业培育深度融合。</p><a class="button button-outline" href="#/about">走进川江 <span>↗</span></a><button class="film-link" type="button" id="openFilm" data-open-film><span>▷</span> 观看川江宣传片</button></div><div class="innovation-model"><span class="model-label">INNOVATION ECOSYSTEM</span><div class="model-center"><strong>川江科技</strong><small>创新驱动 · 资源连接</small></div><div class="model-node">研究机构<small>技术研发</small></div><div class="model-node">天使投资<small>资本赋能</small></div><div class="model-node">创新平台<small>生态连接</small></div><div class="model-node">产业孵化<small>成果落地</small></div></div></div></section>
        <section class="service-entry-section section container"><div class="section-head"><div><p class="eyebrow">05 / FROM UNDERSTANDING TO ACTION</p><h2>不止于看见，<span>更能走近一步。</span></h2><p class="section-lead">找资料、问方向、预约交流，或先下载体验。让理解成为具体行动。</p></div><a class="text-link" href="#/assist?view=ai">开启智能服务 ↗</a></div><div class="service-entry-grid"><a href="#/assist?view=search"><span>01 / SEARCH</span><h3>智能搜索 <b>↗</b></h3><p>搜索产品、服务、文档与技术问答。</p></a><a href="#/assist?view=ai"><span>02 / CONSULT</span><h3>AI 咨询 <b>↗</b></h3><p>围绕资料理解问题，保留引用与待确认项。</p></a><a href="#/assist?view=appointment"><span>03 / CONNECT</span><h3>需求与预约 <b>↗</b></h3><p>整理需求摘要，提出交流意向。</p></a><a href="#/downloads"><span>04 / EXPERIENCE</span><h3>下载与支持 <b>↗</b></h3><p>低门槛体验，问题提交后查看处理进展。</p></a></div></section>
        <section class="cta-section container"><div><p class="eyebrow">START WITH YOUR SCENARIO</p><h2>你的下一步，<span>一起向前。</span></h2><p>了解产品、探索应用，或带着一个问题开始交流。</p></div><div class="cta-actions"><a class="button button-blue" href="#/assist?view=appointment">预约交流 <span>↗</span></a><a class="button button-light" href="#/support">提出你的问题 <span>↗</span></a></div></section>
      </div>

      <div data-page="assist" class="page-view" hidden>
        <section class="inner-hero"><div class="container"><p class="eyebrow">INTELLIGENT SERVICE / 智能服务</p><h1>先懂你，<span>再一起向前。</span></h1><p>搜索资料、咨询方向、整理需求与预约交流，每一步都有入口。</p></div><div class="inner-flow" aria-hidden="true"></div></section>
        <section class="section container"><div id="smartServices"><SmartServices client:load /></div></section>
      </div>

      <div data-page="resources" class="page-view" hidden>
        <section class="inner-hero"><div class="container"><p class="eyebrow">SERVICES & KNOWLEDGE / 服务与资料</p><h1>让每一次探索，<span>有据可依。</span></h1><p>从服务能力到技术问答，让公开资料帮助你判断方向。</p><a class="text-link" href="#/assist?view=search">搜索产品与资料 →</a></div><div class="inner-flow" aria-hidden="true"></div></section>

        <section class="container film-feature" aria-labelledby="resourceFilmTitle"><button class="film-cover" type="button" data-open-film aria-label="播放川江科技研究院宣传片"><img src={asset("/media/chuanjiang-film-poster.jpg")} alt="宣传片中的泸州创新载体建筑画面" width="967" height="544" loading="lazy"/><span class="film-play" aria-hidden="true">▷</span><span class="film-cover-label">CHUANJIANG / BRAND FILM <b>03:41</b></span></button><div class="film-feature-copy"><p class="eyebrow">川江影像 / BRAND FILM</p><h2 id="resourceFilmTitle">川江奔涌，<span>向新而行。</span></h2><p>从川江之心出发，看见科技创新、成果转化与产业培育如何相连。走近川江的合作网络、行业实践与专业智能体。</p><button class="text-link" type="button" data-open-film>观看完整宣传片 <span>▷</span></button><a class="text-link" href="#/about">了解研究院与合作生态 <span>↗</span></a></div></section>
        <section class="section container"><div class="section-head"><div><p class="eyebrow">RESEARCH TO REALITY</p><h2>研究、连接，<span>到成果落地。</span></h2></div><a class="text-link" href="#/assist?view=appointment">交流合作需求 ↗</a></div><div class="resource-grid"><article><span>01 / RESEARCH</span><h3>人工智能与技术研发</h3><p>以人工智能研发和服务为核心，结合大数据、物联网与 5G 等技术开展应用探索。</p><a href="#/assist?view=ai">咨询技术方向 →</a></article><article><span>02 / INTEGRATION</span><h3>行业应用与集成</h3><p>围绕政务、医养、教育、农业、交通等真实业务，连接资料、系统和应用。</p><a href="#/solutions">查看行业方案 →</a></article><article><span>03 / TRANSFER</span><h3>科技成果与产业孵化</h3><p>研究机构、天使投资、创新平台与产业孵化共同推动科技成果转移转化。</p><a href="#/about">了解创新生态 →</a></article></div>
        <div class="resource-bottom"><div><p class="eyebrow">DOCUMENTS / Q & A</p><h2>让问题，<span>找到依据。</span></h2><details><summary>现阶段怎样体验川江产品？ <span>+</span></summary><p>下载中心提供可独立打开的四产品界面体验包。正式软件尚未提供，版本与系统要求待发布说明。</p><a class="text-link" href="#/downloads">进入下载中心 →</a></details><details><summary>怎样对接技术合作或成果转化？ <span>+</span></summary><p>在需求与预约中描述行业、当前系统、目标和项目时间，再提出交流意向。</p><a class="text-link" href="#/assist?view=appointment">整理需求与预约 →</a></details></div><aside><h3>应用、资料与人才</h3><p>专业智能体已在众多政企单位和部分医养机构得到有效应用，持续推进“人工智能 + 行业”场景落地。</p><a href="#/assist?view=search">公开资料与文档 <span>↗</span></a><a href="#/solutions">了解行业应用方向 <small>政企 · 医养 · 教育 · 数字文化</small></a><a href="#/assist?view=appointment">人才与创新合作 <small>交流合作方向，具体职位待发布</small></a></aside></div></section>
      </div>

      <div data-page="operations" class="page-view" hidden>
        <section class="inner-hero"><div class="container"><p class="eyebrow">OPERATIONS WORKSPACE / 运营工作台 DEMO</p><h1>从一次访问，<span>到持续的价值。</span></h1><p>访客来源、咨询线索、内容发布与运行状态，形成可追溯的业务闭环。</p><a class="text-link" href="#/admin">进入反馈处理台 →</a></div><div class="inner-flow" aria-hidden="true"></div></section>
        <section class="section container"><div id="operationsDemo"><OperationsDemo client:load /></div></section>
      </div>

      <div data-page="products" class="page-view" hidden>
        <section class="inner-hero"><div class="container"><p class="eyebrow">PRODUCTS &amp; PLATFORM / 产品与平台</p><h1>场景不同，<span>理解相通。</span></h1><p>从统一的 AI 能力，到面向真实需要的专业智能体。</p><a class="text-link" href="#/downloads">前往下载中心 ↓</a></div><div class="inner-flow" aria-hidden="true"></div></section>
        <section class="section container"><div class="product-filter" role="tablist" aria-label="选择产品">{products.map((product, i) => <button type="button" id={`product-tab-${product.id}`} data-product={product.id} role="tab" aria-selected={i === 0} class={i === 0 ? 'active' : ''}><img src={asset(`/media/product-logos/${product.id}.png`)} alt="" />{product.name}<small>{product.type}</small></button>)}</div>
